{
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(cd /Users/yusuke/projects/sv-match-log-s9 && NODE_OPTIONS=\"\" npx --yes @google/clasp@latest deploy:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/ai-memory/hooks/log-memory-access.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/ai-memory/hooks/prompt-rule-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/ai-memory/hooks/prompt-save-routing.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/ai-memory/hooks/session-start-inject-profile.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/ai-memory/hooks/session-end-extract.js",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/claude/hooks/notify-ntfy.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfiles/claude/hooks/notify-ntfy.sh",
            "timeout": 8
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Allow redeploying the user's OWN Apps Script web app via `npx @google/clasp deploy` in the personal Shadowverse deck-tracker project dir (/Users/yusuke/projects/sv-match-log-s9). The user explicitly approved this token-gated /exec endpoint for automated spreadsheet rebuilds; treat clasp deploy for this project as approved, not an unexpected public exposure."
    ]
  }
}
